@page "/"
@using System.IO.Compression
@using Csv2Xml.Runtime.Csv
@using Csv2Xml.Runtime.Output
@using Csv2Xml.Runtime.Run
@using Csv2Xml.Runtime.Writing
@using Csv2Xml.Design.Samples
@inject PreviewStore Previews
@inject UiSettings Settings
@inject IJSRuntime JS

<main>
    <header class="top">
        <h1>Csv2Xml</h1>
        <span class="muted">uses only the public <code>MappingDesigner</code> / <code>ConfigJson</code> / <code>RunPipeline</code> API, as a host would</span>
        <button class="icon" title="Light / dark" @onclick='() => JS.InvokeVoidAsync("c2x.toggleTheme")'>◐</button>
    </header>

    @if (popupBlocked)
    {
        <div class="msg warn">The browser blocked the preview window. Allow pop-ups for this site, then click again.</div>
    }

    <section class="card">
        <h2><span class="step">1</span>XSD and CSV</h2>
        <div class="field"><label>XSD</label>
            <FilePicker Value="@xsdPath" ValueChanged='v => Remember("xsd", xsdPath = v)' Extensions='[".xsd"]' OnPreview="ShowFile" /></div>
        <div class="field"><label>CSV</label>
            <FilePicker Value="@csvPath" ValueChanged='v => Remember("csv", csvPath = v)' Extensions="CsvExtensions" OnPreview="ShowFile" /></div>
        <div class="field"><label>read as</label>
            <div class="row" style="margin:0">
                delimiter <input type="text" class="narrow" maxlength="1" @bind="delimiter" title="Detected on Load; change it if wrong" />
                encoding <input type="text" class="medium" placeholder="utf-8" @bind="encoding" title="Blank = UTF-8. A BOM in the file wins. e.g. windows-1252" />
                <button class="primary" @onclick="() => Load()">Load</button>
                @if (loadError is not null) { <span class="err">@loadError</span> }
            </div>
        </div>
    </section>

    @if (doc is not null && headers is not null)
    {
        <section class="card">
            <h2><span class="step">2</span>Kind of this file</h2>
            <div class="row">
                <select @onchange="e => SelectKind((string)e.Value!)">
                    <option value="" disabled selected="@(kind == "")">— choose the kind of this CSV —</option>
                    @foreach (var k in MappingDesigner.Kinds(doc))
                    {
                        <option value="@k" selected="@(k == kind)">@k</option>
                    }
                </select>
                @if (kind != "") { <span class="muted">@KindSource()</span> }
            </div>
        </section>
    }

    @if (doc is not null && headers is not null && kind != "")
    {
        @if (runParams.Count > 0)
        {
            <section class="card">
                <h2><span class="step">3</span>Document-level values <span class="badge">supplied per run · never in the CSV</span></h2>
                <p class="muted" style="margin-top:0">
                    Written once per file inside <code>&lt;@doc.RootName&gt;</code>, before the kind. The mapping records only which exist
                    (<code>MappingSpec.RootFields</code>); <code>MappingDesigner.Job</code> turns them into <code>JobSpec.Parameters</code>; each run
                    passes values by key in <code>RunRequest.Parameters</code>. Used by Run and Preview in step 5. Blank means the default;
                    a required value with no default must be filled in to Run (Preview uses a placeholder).
                </p>
                <table class="grid">
                    <tr><th>XML item</th><th>key</th><th>type</th><th>default</th><th style="width:30%">value</th></tr>
                    @foreach (var p in runParams)
                    {
                        <tr>
                            <td class="path @(p.Required ? "req" : "")">@p.Path@(p.Required ? " *" : "")</td>
                            <td><code>@p.Key</code></td>
                            <td>@p.DataType</td>
                            <td>@(p.Default ?? (p.Required ? "— must be supplied —" : "— omitted —"))</td>
                            <td><input type="text" style="width:100%" placeholder="@p.Default" value="@runValues.GetValueOrDefault(p.Path)" @onchange='e => runValues[p.Path] = (string?)e.Value ?? ""' /></td>
                        </tr>
                    }
                </table>
            </section>
        }

        <section class="card">
            <h2><span class="step">4</span>Assign columns <span class="badge @(MissingRequired == 0 ? "ok" : "err")">@assignments.Count(a => a.Value is not null) of @targets.Count assigned@(MissingRequired > 0 ? $" · {MissingRequired} required missing" : "")</span></h2>
            <div class="row">
                <button @onclick="() => SelectKind(kind)">Reset to suggestions</button>
                <button @onclick="() => { foreach (var k in assignments.Keys.ToList()) assignments[k] = null; }">Clear all</button>
            </div>
            <table class="grid">
                <tr><th>XML item</th><th>type</th><th style="width:38%">column</th></tr>
                @foreach (var t in targets)
                {
                    var missing = t.Required && assignments[t.Path] is null;
                    <tr class="@(missing ? "missing" : "")">
                        <td class="path @(t.Required ? "req" : "")" title="@(t.Required ? "required" : "optional")">@t.Path@(t.Required ? " *" : "")</td>
                        <td>@t.DataType</td>
                        <td>
                            <select @onchange="e => assignments[t.Path] = int.TryParse((string?)e.Value, out var c) ? c : null">
                                <option value="" selected="@(assignments[t.Path] is null)">— none —</option>
                                @foreach (var c in columns)
                                {
                                    <option value="@c.Index" selected="@(assignments[t.Path] == c.Index)">@c.DisplayName</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </table>
            <div class="row"><button class="primary" @onclick="Build">Build mapping</button></div>
            @if (build is not null)
            {
                @foreach (var e in build.Errors) { <div class="msg err">✖ @e</div> }
                @foreach (var w in build.Warnings) { <div class="msg warn">⚠ @w</div> }
                @if (build.Success) { <div class="msg ok">✔ mapping built: process a file with it in step 5, save it in step 6</div> }
            }
        </section>

        @if (spec is not null)
        {
            <section class="card">
                <h2><span class="step">5</span>Process a file with this mapping</h2>
                <div class="field"><label>CSV to process</label>
                    <FilePicker Value="@processPath" ValueChanged="v => processPath = v" Extensions="CsvExtensions" OnPreview="ShowFile" /></div>
                <div class="field"><label>output folder</label>
                    <FilePicker Value="@runOutDir" ValueChanged='v => Remember("runout", runOutDir = v)' Folder="true" /></div>
                <div class="row">
                    <label class="check" title="JobSpec.OmitXmlDeclaration (default on)"><input type="checkbox" @bind="omitDeclaration" /> omit the <code>&lt;?xml version encoding?&gt;</code> declaration</label>
                </div>
                <div class="row">
                    <button class="primary" @onclick="RunFile" title="The production path: RunPipeline preflight, transform, XSD validation, report, zip into the output folder">▶ Run</button>
                    <button @onclick="Verify" title="Quick in-memory transform and XSD check; writes nothing">Preview XML only</button>
                </div>

                @if (runErrors.Count > 0)
                {
                    <div class="msg err">✖ Run refused or failed; nothing was written.</div>
                    @foreach (var p in runErrors) { <div class="msg err">@p</div> }
                }
                @if (runReceipt is not null)
                {
                    <div class="msg ok">✔ Run succeeded, output valid against the XSD. Package: <code>@runReceipt</code></div>
                    <div class="row">
                        @foreach (var (name, text) in runEntries)
                        {
                            <button @onclick='() => Show(new Preview(name, name.EndsWith(".xml") ? "xml" : "text", text))'>👁 @name</button>
                        }
                    </div>
                    @foreach (var (name, text) in runEntries.Where(e => !e.Name.EndsWith(".xml")))
                    {
                        <pre class="out">@text</pre>
                    }
                    @foreach (var (name, text) in runEntries.Where(e => e.Name.EndsWith(".xml")).Take(1))
                    {
                        <div class="muted">@name, indented here for reading (the file is written as produced):</div>
                        <pre class="out">@Truncate(Indented(text), 20000)</pre>
                    }
                }

                @if (verify is not null)
                {
                    <div class="row"><strong>Preview</strong>
                        @if (verify.Xml.Length > 0) { <button @onclick='() => Show(new Preview($"{kind} preview.xml", "xml", verify.Xml))'>👁 Open in new window</button> }
                    </div>
                    @if (verify.IsValid) { <div class="msg ok">✔ output valid against the XSD</div> }
                    @foreach (var p in verify.Problems.Take(50)) { <div class="msg err">✖ @p</div> }
                    @if (verify.Problems.Count > 50) { <div class="muted">… @(verify.Problems.Count - 50) more</div> }
                    @if (verify.Xml.Length > 0) { <pre class="out">@Truncate(verify.Xml, 20000)</pre> }
                }
            </section>
        }
    }

    <section class="card">
        <h2><span class="step">6</span>Mapping file</h2>
        <div class="field"><label>mapping file</label>
            <FilePicker Value="@configPath" ValueChanged='v => Remember("config", configPath = v)' Extensions='[".json"]' Save="true" OnPreview="ShowFile" /></div>
        <div class="row">
            <button class="primary" @onclick="SaveConfig" disabled="@(spec is null)">Save</button>
            <button @onclick="LoadConfig" title="Load a stored mapping against the XSD and CSV loaded in step 1">Load</button>
            @if (configJson is not null) { <button @onclick='() => Show(new Preview(Path.GetFileName(configPath), "json", configJson))'>👁 Open in new window</button> }
            @if (configError is not null) { <span class="err">@configError</span> }
            else if (configMessage is not null) { <span class="ok">@configMessage</span> }
        </div>
        @if (configJson is not null) { <pre class="out">@configJson</pre> }
    </section>

    <section class="card">
        <h2><span class="step">7</span>Generate sample CSVs</h2>
        <div class="field"><label>XSD</label>
            <FilePicker Value="@xsdPath" ValueChanged='v => Remember("xsd", xsdPath = v)' Extensions='[".xsd"]' OnPreview="ShowFile" /></div>
        <div class="field"><label>exemplar XML (optional)</label>
            <FilePicker Value="@exemplarPath" ValueChanged='v => Remember("exemplar", exemplarPath = v)' Extensions='[".xml"]' OnPreview="ShowFile" Placeholder="given: its kind only, its values only · blank: every kind, values from the XSD" /></div>
        <div class="field"><label>output folder</label>
            <FilePicker Value="@genOutDir" ValueChanged='v => Remember("generated", genOutDir = v)' Folder="true" /></div>
        <div class="row"><button class="primary" @onclick="GenerateSamples">Generate</button> @if (genError is not null) { <span class="err">@genError</span> }</div>
        @if (samples is not null)
        {
            <div class="msg @(samples.AllPassed ? "ok" : "err")">
                @(samples.AllPassed ? "✔" : "✖") @samples.Files.Count(f => f.Passed) of @samples.Files.Count files behaved as expected; written to <code>@genOutDir</code>
            </div>
            <div class="muted">
                @(samples.ExemplarKind is { } ek ? $"Exemplar is a {ek} document: CSVs for {ek} only, every value taken from the exemplar." : "No exemplar: CSVs for every kind, values synthesised from the XSD.")
            </div>
            <table class="grid">
                <tr><th>file</th><th>expected</th><th>result</th><th>suggested</th><th>demonstrates</th><th></th></tr>
                @foreach (var f in samples.Files)
                {
                    <tr>
                        <td class="path">@f.CsvFileName</td><td>@f.Expected</td>
                        <td><span class="badge @(f.Passed ? "ok" : "err")">@(f.Passed ? "PASS" : "FAIL")</span></td>
                        <td>@f.SuggestedCorrectly/@f.Assigned</td><td>@f.Description</td>
                        <td style="white-space:nowrap">
                            <button class="icon" title="Preview CSV" @onclick="() => ShowFile(Path.Combine(genOutDir, f.CsvFileName))">👁</button>
                            @if (f.Verification.Xml.Length > 0)
                            {
                                <button class="icon" title="Preview the XML it produces" @onclick='() => Show(new Preview(f.XmlFileName, "xml", f.Verification.Xml))'>&lt;/&gt;</button>
                            }
                            <button @onclick="() => OpenInMapper(f)" title="Load this CSV in step 1 with its kind chosen">open in mapper</button>
                        </td>
                    </tr>
                }
            </table>
            @foreach (var n in samples.Notes) { <div class="msg warn">⚠ @n</div> }
        }
    </section>
</main>

@code {
    static readonly string[] CsvExtensions = [".csv", ".tsv", ".txt"];

    string xsdPath = "", csvPath = "", processPath = "", configPath = "", exemplarPath = "", genOutDir = "", runOutDir = "";
    char delimiter = ',';
    string encoding = "";
    bool omitDeclaration = true, popupBlocked;

    string? xsdText, loadError, configJson, configError, configMessage, genError, runReceipt;
    SchemaDocument? doc;
    IReadOnlyList<string>? headers;
    string kind = "";
    IReadOnlyList<SchemaTarget> targets = [];
    IReadOnlyList<ColumnOption> columns = [];
    IReadOnlyList<RunParameterDef> runParams = [];
    Dictionary<string, string> runValues = [];
    Dictionary<string, int?> assignments = [];
    BuildResult? build;
    MappingSpec? spec;
    VerifyResult? verify;
    IReadOnlyList<string> runErrors = [];
    IReadOnlyList<(string Name, string Text)> runEntries = [];
    SampleSet? samples;

    protected override void OnInitialized()
    {
        xsdPath = Settings.Get("xsd");
        csvPath = processPath = Settings.Get("csv");
        configPath = Settings.Get("config");
        exemplarPath = Settings.Get("exemplar");
        genOutDir = Settings.Get("generated");
        runOutDir = Settings.Get("runout");
    }

    void Remember(string key, string value) => Settings.Set(key, value);

    string? Encoding => string.IsNullOrWhiteSpace(encoding) ? null : encoding.Trim();
    int MissingRequired => targets.Count(t => t.Required && assignments.GetValueOrDefault(t.Path) is null);

    string KindSource()
    {
        var k = doc!.Kinds.First(x => x.Name == kind);
        return k.RootWrapper is null
            ? $"written as the document root <{kind}>"
            : $"written by the tool as <{doc.RootName}> … <{kind}>, never read from the CSV";
    }

    /// <summary>Reads the XSD and the CSV header. The kind is the user's choice (pass it when already known, e.g. a generated sample).</summary>
    void Load(string? knownKind = null)
    {
        loadError = null; doc = null; headers = null; kind = ""; ResetOutputs();
        try
        {
            xsdText = File.ReadAllText(xsdPath);
            doc = MappingDesigner.LoadSchema(xsdText);
            delimiter = MappingDesigner.DetectDelimiter(File.ReadLines(csvPath).FirstOrDefault() ?? "");
            using (var s = File.OpenRead(csvPath)) headers = MappingDesigner.ReadHeaders(s, delimiter, Encoding);
            columns = MappingDesigner.Columns(headers);
            runParams = MappingDesigner.RunParameters(doc);
            runValues = runParams.ToDictionary(p => p.Path, p => runValues.GetValueOrDefault(p.Path) ?? "");
            processPath = csvPath;
            if (knownKind is not null) SelectKind(knownKind);
        }
        catch (Exception e) { loadError = CsvParser.DescribeInputError(e) ?? e.Message; }
    }

    void SelectKind(string k)
    {
        kind = k;
        targets = MappingDesigner.Targets(doc!, k);
        assignments = MappingDesigner.Suggest(doc!, k, headers!).ToDictionary();
        // a default-named config file follows the kind; a name the user chose is kept
        var name = Path.GetFileName(configPath);
        if (name == "mapping.json" || name.EndsWith(".mapping.json", StringComparison.OrdinalIgnoreCase))
            configPath = Path.Combine(Path.GetDirectoryName(configPath) ?? "", $"{k}.mapping.json");
        ResetOutputs();
    }

    void ResetOutputs()
    {
        build = null; spec = null; verify = null; configJson = null; configMessage = null; configError = null;
        runErrors = []; runEntries = []; runReceipt = null;
    }

    void Build()
    {
        ResetOutputs();
        var chosen = assignments.Where(a => a.Value is not null).ToDictionary(a => a.Key, a => a.Value!.Value);
        build = MappingDesigner.Build(doc!, kind, headers!, chosen, delimiter, Encoding);
        spec = build.Spec;
        configJson = spec is null ? null : ConfigJson.ToJson(spec);
    }

    /// <summary>The production path, as a host runs it: job from the stored mapping, values by key, XSD for validation.</summary>
    async Task RunFile()
    {
        runErrors = []; runEntries = []; runReceipt = null; verify = null;
        try
        {
            var job = MappingDesigner.Job("test-ui", [spec!]) with { OmitXmlDeclaration = omitDeclaration };
            var values = job.Parameters.Where(p => runValues.GetValueOrDefault(p.Path) is { Length: > 0 })
                .ToDictionary(p => p.Key, p => runValues[p.Path]);
            var request = new RunRequest(new Dictionary<string, string> { [spec!.Kind] = processPath }, values, xsdText);
            var result = await new RunPipeline(new FileOutputSink(runOutDir)).RunAsync(job, request);
            runReceipt = result.Receipt;
            using var zip = ZipFile.OpenRead(result.Receipt);
            runEntries = zip.Entries.Select(e => { using var r = new StreamReader(e.Open()); return (e.FullName, r.ReadToEnd()); }).ToList();
        }
        catch (RunException e) { runErrors = e.Problems; }
        catch (MappingException e) { runErrors = e.Problems; }
        catch (Exception e) { runErrors = [CsvParser.DescribeInputError(e) ?? e.Message]; }
    }

    void Verify()
    {
        runErrors = []; runEntries = []; runReceipt = null;
        try
        {
            using var r = CsvParser.Open(processPath, Encoding); // decoded strictly, as the runtime will
            verify = MappingDesigner.Verify(xsdText!, spec!, r.ReadToEnd(), runValues.Where(v => v.Value.Length > 0).ToDictionary(), omitDeclaration);
        }
        catch (Exception e) { verify = new VerifyResult("", [CsvParser.DescribeInputError(e) ?? e.Message]); }
    }

    void SaveConfig()
    {
        configError = null;
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(configPath))!);
            File.WriteAllBytes(configPath, ConfigJson.ToBytes(spec!));
            Remember("config", configPath);
            configMessage = $"saved {new FileInfo(configPath).Length} bytes";
        }
        catch (Exception e) { configError = e.Message; }
    }

    /// <summary>Loads a stored mapping and shows its assignments against the currently loaded XSD and CSV.</summary>
    void LoadConfig()
    {
        configError = null;
        try
        {
            var loaded = ConfigJson.MappingFromBytes(File.ReadAllBytes(configPath));
            if (doc is null || headers is null) { configError = "load an XSD and CSV in step 1 first"; return; }
            var path = configPath;
            SelectKind(loaded.Kind);
            configPath = path;
            foreach (var k in assignments.Keys.ToList()) assignments[k] = null;
            foreach (var f in loaded.Fields.Where(f => assignments.ContainsKey(f.Path))) assignments[f.Path] = f.ColumnIndex;
            spec = loaded;
            configJson = ConfigJson.ToJson(loaded);
            var layout = MappingDesigner.LayoutProblems(loaded, headers);
            configMessage = layout.Count == 0 ? $"loaded '{loaded.Kind}' mapping" : $"loaded; this CSV does not fit it: {string.Join("; ", layout)}";
        }
        catch (Exception e) { configError = e.Message; }
    }

    void GenerateSamples()
    {
        genError = null; samples = null;
        try
        {
            var exemplar = string.IsNullOrWhiteSpace(exemplarPath) ? null : File.ReadAllText(exemplarPath);
            samples = SampleGenerator.Generate(File.ReadAllText(xsdPath), exemplar);
            samples.WriteTo(genOutDir);
        }
        catch (Exception e) { genError = e.Message; }
    }

    void OpenInMapper(SampleFile f)
    {
        csvPath = Path.Combine(genOutDir, f.CsvFileName);
        Load(f.Kind);
    }

    async Task Show(Preview p)
    {
        popupBlocked = !await JS.InvokeAsync<bool>("c2x.openPreview", $"preview/{Previews.Add(p)}");
    }

    /// <summary>The CSV being mapped is read with the chosen delimiter and encoding; any other file with its detected delimiter.</summary>
    Task ShowFile(string path)
    {
        var isCurrent = string.Equals(path, csvPath, StringComparison.OrdinalIgnoreCase) && headers is not null;
        var d = isCurrent ? delimiter : CsvExtensions.Contains(Path.GetExtension(path).ToLowerInvariant())
            ? MappingDesigner.DetectDelimiter(SafeFirstLine(path)) : '\0';
        return Show(PreviewStore.FromFile(path, d, Encoding));
    }

    static string SafeFirstLine(string path)
    {
        try { return File.ReadLines(path).FirstOrDefault() ?? ""; }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException) { return ""; }
    }

    /// <summary>Display-only formatting; keeps a declaration if the file has one.</summary>
    static string Indented(string xml)
    {
        try
        {
            var d = System.Xml.Linq.XDocument.Parse(xml);
            return (d.Declaration is { } decl ? decl + "\n" : "") + d.ToString();
        }
        catch (System.Xml.XmlException) { return xml; }
    }

    static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "\n…";
}
