<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>toolrunner</AssemblyName>
    <RootNamespace>ToolRunner</RootNamespace>
  </PropertyGroup>

  <!-- Dev-only: builds the fake docker before toolrunner so F5 launch profiles can put it on PATH. Not copied or linked. -->
  <ItemGroup>
    <ProjectReference Include="..\FakeDocker\FakeDocker.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The sample config is copied beside the exe, so `toolrunner` also works when run from bin\. -->
  <ItemGroup>
    <None Update="config\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
