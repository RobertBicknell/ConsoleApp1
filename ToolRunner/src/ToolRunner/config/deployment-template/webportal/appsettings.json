{
  "Authentication": {
    "Authority": "{{keycloak.url}}/realms/{{REALM}}",
    "ClientId": "{{webportal.client}}",
    "MetadataAddress": "{{keycloak.internalUrl}}/realms/{{REALM}}/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Portal": {
    "Title": "{{PRODUCT_TITLE}}",
    "ProductConfigUrl": "http://productconfig:8080"
  },
  "Plugins": {
    "Assemblies": [ {{PLUGINS:webportal}} ]
  }
}
