# Images
REGISTRY={{REGISTRY}}
PRODUCT_VERSION={{VERSION}}
POSTGRES_VERSION=16.3

# Ports on the host
PRODUCTCONFIG_PORT={{PORT+1}}
WEBPORTAL_PORT={{PORT+2}}

# Keycloak (its own stack, in the keycloak folder)
KEYCLOAK_REALM={{REALM}}
KEYCLOAK_URL={{keycloak.url}}
KEYCLOAK_INTERNAL_URL={{keycloak.internalUrl}}
IDENTITY_NETWORK={{IDENTITY_NETWORK}}

# Database
DB_NAME={{product_title}}
DB_USER={{product_title}}
DB_PASSWORD={{SECRET:db}}
