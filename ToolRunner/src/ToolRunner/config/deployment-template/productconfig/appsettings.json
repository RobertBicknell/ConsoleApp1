{
  "Authentication": {
    "Authority": "{{keycloak.url}}/realms/{{REALM}}",
    "ClientId": "{{productconfig.client}}",
    "MetadataAddress": "{{keycloak.internalUrl}}/realms/{{REALM}}/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": {
    "Main": "Host=db;Database={{product_title}};Username={{product_title}};Password={{SECRET:db}}"
  },
  "Product": {
    "Title": "{{PRODUCT_TITLE}}",
    "Entities": "{{ENTITIES}}"
  },
  "Plugins": {
    "Assemblies": [ {{PLUGINS:productconfig}} ]
  }
}
